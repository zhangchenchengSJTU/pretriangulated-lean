import PretriangulatedV2.StableLinear
import Mathlib.CategoryTheory.Idempotents.Basic
import Mathlib.RingTheory.Artinian.Module
import Mathlib.Algebra.Algebra.Subalgebra.Lattice

/-!
# Idempotents in Hom-finite stable quotients

In a finite-dimensional algebra, every element whose image is idempotent
can be replaced by an actual idempotent with the same image. The proof uses
stabilization of powers in the commutative subalgebra generated by the element.
Consequently any full, essentially surjective functor from a Hom-finite
idempotent-complete linear category has an idempotent-complete target. This
applies to the actual quotient by maps through projectives.
-/

noncomputable section

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe w v v' u u'

open CategoryTheory CategoryTheory.Category CategoryTheory.Limits
open scoped IsMulCommutative

namespace PretriangulatedV2.IdempotentLifting

variable {R S : Type*} [CommRing R] [Monoid S] [IsArtinianRing R]

/-- Powers stabilize in an Artinian commutative ring, giving an idempotent
with the same image under any multiplicative map. -/
theorem exists_lift_of_commRing (f : R →* S) (a : R)
    (ha : IsIdempotentElem (f a)) :
    ∃ e : R, IsIdempotentElem e ∧ f e = f a := by
  obtain ⟨n, hn⟩ := IsArtinian.range_smul_pow_stabilizes R a
  let N := n + 1
  have hN : n ≤ N := Nat.le_succ n
  have hNN : n ≤ N + N := hN.trans (Nat.le_add_right N N)
  have hrange :
      LinearMap.range (a ^ N • LinearMap.id : R →ₗ[R] R) =
        LinearMap.range (a ^ (N + N) • LinearMap.id : R →ₗ[R] R) :=
    (hn N hN).symm.trans (hn (N + N) hNN)
  have hmem : a ^ N ∈ LinearMap.range (a ^ N • LinearMap.id : R →ₗ[R] R) :=
    ⟨1, by simp⟩
  rw [hrange] at hmem
  obtain ⟨b, hb⟩ := hmem
  change a ^ (N + N) * b = a ^ N at hb
  refine ⟨a ^ N * b, ?_, ?_⟩
  · change (a ^ N * b) * (a ^ N * b) = a ^ N * b
    calc
      (a ^ N * b) * (a ^ N * b) = (a ^ N * a ^ N * b) * b := by ring
      _ = a ^ N * b := by rw [← pow_add, hb]
  · have hfb : f a * f b = f a := by
      have hpowN : f a ^ N = f a := ha.pow_eq (by dsimp [N]; omega)
      have hpowNN : f a ^ (N + N) = f a := ha.pow_eq (by dsimp [N]; omega)
      simpa only [map_mul, map_pow, hpowN, hpowNN] using congrArg f hb
    simpa only [map_mul, map_pow, N, ha.pow_succ_eq] using hfb

section Algebra

variable {k : Type w} [Field k] {A : Type u} [Ring A] [Algebra k A]
  [FiniteDimensional k A] {T : Type u'} [Monoid T]

include k in
/-- Idempotents lift from any multiplicative image of a finite-dimensional
algebra, without a nilpotence assumption on the kernel. -/
theorem exists_lift_of_finiteDimensional (f : A →* T) (a : A)
    (ha : IsIdempotentElem (f a)) :
    ∃ e : A, IsIdempotentElem e ∧ f e = f a := by
  let B : Subalgebra k A := Algebra.adjoin k ({a} : Set A)
  let b : B := ⟨a, Algebra.self_mem_adjoin_singleton k a⟩
  have : FiniteDimensional k B := inferInstance
  have : IsArtinianRing B := IsArtinianRing.of_finite k B
  obtain ⟨e, he, hfe⟩ := exists_lift_of_commRing
    (f.comp B.subtype.toMonoidHom) b ha
  exact ⟨e.1, he.map B.subtype.toMonoidHom, hfe⟩

end Algebra

end PretriangulatedV2.IdempotentLifting

namespace CategoryTheory.Functor

variable {k : Type w} [Field k]
  {C : Type u} [Category.{v} C] [Preadditive C] [CategoryTheory.Linear k C]
  [∀ X : C, FiniteDimensional k (End X)]
  {D : Type u'} [Category.{v'} D]

include k in
/-- A full functor out of a category with finite-dimensional endomorphism
algebras lifts actual idempotents. -/
theorem exists_idempotent_preimage (F : C ⥤ D) [F.Full]
    (X : C) (p : F.obj X ⟶ F.obj X) (hp : p ≫ p = p) :
    ∃ e : X ⟶ X, e ≫ e = e ∧ F.map e = p := by
  obtain ⟨a, ha⟩ := F.map_surjective p
  obtain ⟨e, he, hfe⟩ := PretriangulatedV2.IdempotentLifting.exists_lift_of_finiteDimensional
    (k := k) (F.mapEnd X) a (show IsIdempotentElem (F.mapEnd X a) by
      change F.map a ≫ F.map a = F.map a
      simpa only [ha] using hp)
  exact ⟨e, he, hfe.trans ha⟩

include k in
/-- A full, essentially surjective functor preserves idempotent completeness
when the source has finite-dimensional endomorphism algebras. -/
theorem isIdempotentComplete_of_full_essSurj_of_finiteDimensional
    [IsIdempotentComplete C] (F : C ⥤ D) [F.Full] [F.EssSurj] :
    IsIdempotentComplete D := by
  constructor
  intro Y p hp
  let X := F.objPreimage Y
  let φ : F.obj X ≅ Y := F.objObjPreimageIso Y
  let p' : F.obj X ⟶ F.obj X := φ.hom ≫ p ≫ φ.inv
  have hp' : p' ≫ p' = p' := by
    simp only [p', Category.assoc, Iso.inv_hom_id_assoc]
    rw [← Category.assoc p p, hp]
  obtain ⟨e, he, hfe⟩ := F.exists_idempotent_preimage (k := k) X p' hp'
  obtain ⟨Z, i, r, hir, hri⟩ := IsIdempotentComplete.idempotents_split X e he
  apply Idempotents.split_imp_of_iso φ (F.map e) p (by simp [hfe, p', Category.assoc])
  refine ⟨F.obj Z, F.map i, F.map r, ?_, ?_⟩
  · rw [← F.map_comp, hir, F.map_id]
  · rw [← F.map_comp, hri]

end CategoryTheory.Functor

namespace PretriangulatedV2.IdealQuotient

variable {k : Type w} [Field k]
  {C : Type u} [Category.{v} C] [Preadditive C] [Linear k C]
  [HasBinaryBiproducts C] [IsIdempotentComplete C]
  [∀ X Y : C, FiniteDimensional k (X ⟶ Y)]
  (B : C → Prop) [Nonempty {X : C // B X}] [ClosedUnderBinaryBiproducts B]

include k in
/-- The actual quotient of a Hom-finite idempotent-complete linear category
by maps through an additive object property is idempotent complete. -/
theorem quotient_isIdempotentComplete : IsIdempotentComplete (category B) := by
  have : ∀ X : C, FiniteDimensional k (End X) := fun X ↦
    inferInstanceAs (FiniteDimensional k (X ⟶ X))
  exact (functor B).isIdempotentComplete_of_full_essSurj_of_finiteDimensional (k := k)

end PretriangulatedV2.IdealQuotient

namespace PretriangulatedV2.StableCategory

variable {k : Type w} [Field k]
  {C : Type u} [Category.{v} C] [Abelian C] [HasBinaryBiproducts C] [Linear k C]
  [∀ X Y : C, FiniteDimensional k (X ⟶ Y)]

include k in
/-- The actual projective stable category of a Hom-finite linear Abelian
category is idempotent complete. In particular this applies to Frobenius
Abelian categories, without assuming idempotent completeness of their quotient. -/
theorem projectiveStableCategory_isIdempotentComplete :
    IsIdempotentComplete (projectiveStableCategory C) :=
  PretriangulatedV2.IdealQuotient.quotient_isIdempotentComplete (k := k)
    (projectiveObjects : C → Prop)

end PretriangulatedV2.StableCategory

namespace PretriangulatedV2.CoherentFunctors

variable {k : Type w} [Field k]
  {C : Type u} [Category.{v} C] [Preadditive C] [Linear k C]
  [HasZeroObject C] [HasBinaryBiproducts C] [HasShift C ℤ]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
  [∀ X Y : C, FiniteDimensional k (X ⟶ Y)]

include k in
/-- The projective stable category of actual coherent functors is idempotent
complete, with Hom-finiteness derived entirely from the original category. -/
theorem stableMod_isIdempotentComplete :
    IsIdempotentComplete (StableCategory.projectiveStableCategory (Mod C)) :=
  StableCategory.projectiveStableCategory_isIdempotentComplete (k := k)

end PretriangulatedV2.CoherentFunctors
