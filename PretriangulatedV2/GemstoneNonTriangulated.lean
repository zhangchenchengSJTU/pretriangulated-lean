import PretriangulatedV2.HellerProposition42
import PretriangulatedV2.GemstonePerturbation
import PretriangulatedV2.StableSupportedCentre

/-! The full gemstone obstruction to a triangulated Heller parameter,
Theorem 6.2, for the actual supplied projective-category shift action. -/

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe w v u
open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Pretriangulated

namespace PretriangulatedV2.StableCategory.GemstoneNonTriangulated

variable {k : Type w} [Field k] {C : Type u} [Category.{v} C]
  [Abelian C] [HasBinaryBiproducts C] [FrobeniusAbelian C] [Linear k C]
  [∀ Y Z : C, FiniteDimensional k (Y ⟶ Z)]
  (S : C ≌ C) [S.functor.Additive]
  [HasShift (HellerClassification.Projectives (C := C)) ℤ]
  [HasBinaryBiproducts (HellerClassification.Projectives (C := C))]
  [∀ n : ℤ, (shiftFunctor (HellerClassification.Projectives (C := C)) n).Additive]
  (e : shiftFunctor (HellerClassification.Projectives (C := C)) (1 : ℤ) ≅
    (HellerClassification.projectiveEquivalence S).functor)

/-- A gemstone in the true Frobenius stable quotient forces the supported
perturbation of any triangulated Heller parameter to fail TR4. The contradiction
uses the actual distinguished rotated gemstone-cone triangle and the fully
proved unconditional Proposition 4.2. -/
theorem theorem_6_2_generic
    (p : HellerExactness.Parameter S) {X : projectiveStableCategory C} (G : Gemstone X)
    (hp : letI := HellerClassification.pretriangulated S p e
      IsTriangulated (HellerClassification.Projectives (C := C))) :
    letI := HellerClassification.pretriangulated S (p.twist (gemstoneCentreUnit (k := k) G)) e
    ¬ IsTriangulated (HellerClassification.Projectives (C := C)) := by
  let : IsIdempotentComplete (projectiveStableCategory C) :=
    projectiveStableCategory_isIdempotentComplete (k := k) (C := C)
  intro hpu
  obtain ⟨T, hT, hU, hY, _, hNL⟩ := G.exists_perturbation_obstruction (k := k)
  have hU' : (gemstoneCentreUnit (k := k) G).iso.hom.app T.obj₁ - 𝟙 _ = 0 := hU
  have hY' : (gemstoneCentreUnit (k := k) G).iso.hom.app T.obj₂ - 𝟙 _ = 0 := hY
  have hl := HellerProposition42.proposition_4_2_generic S e p
    (gemstoneCentreUnit (k := k) G) hp hpu T hT hU' hY'
  exact hNL hl

omit [HasShift (HellerClassification.Projectives (C := C)) ℤ]
  [HasBinaryBiproducts (HellerClassification.Projectives (C := C))]
  [∀ n : ℤ, (shiftFunctor (HellerClassification.Projectives (C := C)) n).Additive] in
/-- Theorem 6.2 specialized to the actual integer shift generated by S. -/
theorem theorem_6_2
    (p : HellerExactness.Parameter S) {X : projectiveStableCategory C} (G : Gemstone X)
    (hp : HellerObstruction.ParameterTriangulated S p) :
    ¬ HellerObstruction.ParameterTriangulated S (p.twist (gemstoneCentreUnit (k := k) G)) := by
  let := HellerClassification.projectiveHasShift S
  let : ∀ n : ℤ, (shiftFunctor (HellerClassification.Projectives (C := C)) n).Additive :=
    fun n => AutoequivalenceShift.shift_additive (HellerClassification.projectiveEquivalence S) n
  let : CategoryTheory.Pretriangulated (HellerClassification.Projectives (C := C)) :=
    HellerClassification.constructedPretriangulated S p
  exact theorem_6_2_generic S (HellerClassification.projectiveShiftOneIso S) p G hp

end PretriangulatedV2.StableCategory.GemstoneNonTriangulated
