import Mathlib.RingTheory.AdjoinRoot
import Mathlib.RingTheory.Artinian.Module

/-!
The actual truncated polynomial algebra R[x]/(x^n), with its root, nilpotence,
finite coefficient module and reduction maps. These are algebraic inputs to
the concrete stable-module counterexample, rather than an abstract replacement
for its module category.
-/

noncomputable section

open Polynomial Module

namespace PretriangulatedV2.TruncatedPolynomialAlgebra

universe u w

variable (R : Type u) [CommRing R]

/-- Exactly the polynomial quotient by the principal ideal generated by x^n. -/
abbrev Trunc (n : ℕ) := AdjoinRoot (X ^ n : R[X])

def quotientIso (n : ℕ) :
    Trunc R n ≃ₐ[R] (R[X] ⧸ Ideal.span {(X ^ n : R[X])}) :=
  AlgEquiv.refl (R := R) (A₁ := Trunc R n)

/-- The actual residue class of the polynomial variable. -/
def x (n : ℕ) : Trunc R n := AdjoinRoot.root (X ^ n : R[X])

@[simp]
theorem x_pow (n : ℕ) : x R n ^ n = 0 := by
  simpa [x] using AdjoinRoot.eval₂_root (X ^ n : R[X])

instance finite (n : ℕ) : Module.Finite R (Trunc R n) :=
  (monic_X_pow n).finite_adjoinRoot

instance free (n : ℕ) : Module.Free R (Trunc R n) :=
  (monic_X_pow n).free_adjoinRoot

variable {R}

/-- Reduction from a longer truncation to a shorter one, constructed from
the genuine polynomial quotient relation. -/
def reduction {n m : ℕ} (hmn : m ≤ n) : Trunc R n →ₐ[R] Trunc R m :=
  AdjoinRoot.liftAlgHom (X ^ n : R[X]) (Algebra.ofId R (Trunc R m)) (x R m) (by
    simp only [eval₂_pow, eval₂_X]
    obtain ⟨t, rfl⟩ := Nat.exists_eq_add_of_le hmn
    rw [pow_add, x_pow, zero_mul])

@[simp]
theorem reduction_x {n m : ℕ} (hmn : m ≤ n) : reduction (R := R) hmn (x R n) = x R m :=
  AdjoinRoot.liftAlgHom_root _ _ _ _

theorem reduction_surjective {n m : ℕ} (hmn : m ≤ n) :
    Function.Surjective (reduction (R := R) hmn) := by
  intro a
  obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective a
  refine ⟨AdjoinRoot.mk _ p, ?_⟩
  rw [← AdjoinRoot.aeval_eq, ← AdjoinRoot.aeval_eq, ← aeval_algHom_apply]
  change aeval (reduction hmn (x R n)) p = aeval (x R m) p
  rw [reduction_x]

section Nontrivial

variable [Nontrivial R]

/-- The actual monomial basis of the quotient, indexed by its truncation length. -/
def basis (n : ℕ) : Basis (Fin n) R (Trunc R n) :=
  (AdjoinRoot.powerBasis' (monic_X_pow n : (X ^ n : R[X]).Monic)).basis.reindex
    (finCongr (by simp))

@[simp]
theorem basis_apply (n : ℕ) (i : Fin n) : basis (R := R) n i = x R n ^ (i : ℕ) := by
  simp [basis, x]

/-- Coefficients are linear coordinates of the actual quotient element. -/
def coefficient (n : ℕ) (i : Fin n) : Trunc R n →ₗ[R] R := (basis (R := R) n).coord i

@[simp]
theorem coefficient_x_pow (n : ℕ) (i j : Fin n) :
    coefficient (R := R) n i (x R n ^ (j : ℕ)) = if j = i then 1 else 0 := by
  rw [← basis_apply]
  simp only [coefficient, Basis.coord_apply, Basis.repr_self, Finsupp.single_apply]

end Nontrivial

section Field

variable {k : Type w} [Field k] [Algebra k R] [FiniteDimensional k R]

instance finiteOverField (n : ℕ) : FiniteDimensional k (Trunc R n) :=
  Module.Finite.trans R (Trunc R n)

end Field

end PretriangulatedV2.TruncatedPolynomialAlgebra
